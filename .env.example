# Terms configuration. Copy to .env and fill in. Never commit .env.

# Meterless Nightshift (primary AI provider). Token from Nightshift → Console.
# The NVIDIA key lives in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=PASTE_RUNTIME_TOKEN
METERLESS_MODEL_DEEP=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b

# Zetaris running locally in Docker. API key from the Zetaris UI.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=PASTE_ZETARIS_API_KEY

# SEC requires a declared User-Agent ("App contact@example.com").
SEC_USER_AGENT=Terms-demo you@example.com

# Signs Scout Intent execution contracts. Any long random string.
TERMS_CONTRACT_SECRET=change-me

# true = no credentials: recorded Zetaris results / local mirror + the desk playbook
SAMPLE_MODE=false
PORT=8010
LOG_LEVEL=INFO
